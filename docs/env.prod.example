# e-MAAFA / DMIS — production environment template
# Copy to a secret store / .env on the host. NEVER commit real values.
# Docker: docs/go-live/DOCKER-DEPLOY.md
# Cutover: docs/GO-LIVE-RUNBOOK.md + docs/go-live/04-ACCEPTANCE.md
#
# HONESTY: env + compose is packaging. It is not a signed go-live certificate.

SPRING_PROFILES_ACTIVE=prod

# ── Public edge (docker-compose.prod.yml Caddy) ─────────────────────────────
DMIS_PUBLIC_HOST=emaafa.pmo.go.tz
CADDY_EMAIL=ops@pmo.go.tz

# ── Immutable images (prefer pull over build on the public host) ────────────
# Built by: ./scripts/docker-release.sh <tag>
DMIS_IMAGE_BACKEND=registry.example.gov/emaafa/dmis-backend:REPLACE_TAG
DMIS_IMAGE_FRONTEND=registry.example.gov/emaafa/dmis-frontend:REPLACE_TAG
DMIS_IMAGE_EW_PDF=registry.example.gov/emaafa/ew-pdf:REPLACE_TAG

# ── Database (app user, not superuser). No weak default on public edge. ─────
DB_HOST=db
DB_PORT=5432
DB_NAME=dmis
DB_USERNAME=dmis_app
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=5

# ── JWT (required; fail-fast if missing/weak/dev-default) ───────────────────
# Generate: openssl rand -base64 48
DMIS_AUTH_JWT_SECRET=
DMIS_AUTH_JWT_TTL_MINUTES=30
DMIS_AUTH_JWT_ISSUER=dmis
DMIS_AUTH_FORCE_2FA_ROLES=Super Admin,Director,Asst. Director,Secretary,EOCC,ICT Admin
# Optional: email of a real Super Admin used only for scheduled job audit rows (empty = Super Admin by role)
DMIS_AUTH_SYSTEM_ACTOR_EMAIL=

# ── CORS (required in non-local; fail-fast if unset) ────────────────────────
# Comma-separated SPA origins. Must match the public HTTPS origin.
# Example: https://emaafa.pmo.go.tz
DMIS_SECURITY_CORS_ALLOWED_ORIGINS=

# Internal PDF health (Docker DNS). Do not point this at a public URL.
DMIS_EW_PDF_HEALTH_URL=http://ew-pdf:8600/health

# ── M-Gov SMS (optional until SMS goes live; accept residual if blank) ──────
MGOV_SMS_URL=
MGOV_API_KEY=
MGOV_SYSTEM_ID=
MGOV_MOBILE_SERVICE_ID=
MGOV_SENDER_ID=
DMIS_MGOV_DLR_SECRET=

# ── SMTP (optional until email goes live) ───────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Enable actuator mail probe only after credentials work:
# MANAGEMENT_HEALTH_MAIL_ENABLED=true

# ── Residual accept (set true only after written sign-off in GO-LIVE-RUNBOOK) ─
# These clear blockers on the readiness board without inventing live keys.
DMIS_GO_LIVE_ACCEPT_SMS_DEFERRED=false
DMIS_GO_LIVE_ACCEPT_EMAIL_DEFERRED=false
DMIS_GO_LIVE_ACCEPT_SPARSE_PHONES=false
DMIS_GO_LIVE_ACCEPT_PDF_SIDECAR=false
DMIS_GO_LIVE_ACCEPT_STORAGE_PARTIAL=false

# Exercise inject scheduler (default false on prod — enable only during deliberate drills)
DMIS_SCENARIO_INJECTS_ENABLED=false

# Refuse start if demo emails lack must_change_password (set true only emergency)
DMIS_ALLOW_DEMO_ACCOUNTS_IN_PROD=false

# ── Delivery retries ────────────────────────────────────────────────────────
DMIS_DELIVERY_RETRY_ENABLED=true
