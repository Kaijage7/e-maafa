"""
Additive mobile/native GraphQL surface — reads and wake-up only.

Use GraphQL where it fits: composite screen reads (mobileHome, incidentWorkspace) and
foreground mobileSync wake-ups. Commands, auth, uploads, offline cursor recovery, and web SSE
remain on REST. Commands remain on REST.
"""
type Query {
  """Incident-capable user's scoped home screen."""
  mobileHome(
    incidentPage: Int = 1
    """Page size for the incident list (1–50; default 15)."""
    incidentLimit: Int = 15
    notificationLimit: Int = 20
    notificationBeforeId: ID
  ): MobileHome!

  """Single incident workspace for a jurisdiction-visible id (detail + bounded tasks/allocations)."""
  incidentWorkspace(id: ID!): IncidentWorkspace!

  """
  Offline bootstrap reference data (hazards, types, controlled lists, regions).
  Large admin/map datasets still download once via REST/geo endpoints and stay local.
  """
  mobileReference: MobileReference!
}

type MobileReference {
  generatedAt: String!
  hazards: [MobileRefItem!]!
  incidentTypes: [MobileIncidentTypeRef!]!
  severityLevels: [String!]!
  sourcesOfReport: [String!]!
  infrastructureDamageOptions: [String!]!
  emergencyNeedsOptions: [String!]!
  regions: [MobileRefItem!]!
}

type MobileRefItem {
  id: ID!
  name: String!
}

type MobileIncidentTypeRef {
  id: ID!
  name: String!
  defaultSeverity: String
}

type IncidentWorkspace {
  generatedAt: String!
  syncCursor: ID!
  syncScopeKey: String!
  incident: MobileIncidentDetail!
  tasks: [MobileIncidentTask!]!
  allocations: [MobileIncidentAllocation!]!
  updatesCount: Int!
  workflowHistoriesCount: Int!
}

type MobileIncidentDetail {
  id: ID!
  title: String!
  status: String
  workflowStatus: String
  workflowStatusLabel: String
  severity: String
  hazardName: String
  incidentTypeName: String
  districtName: String
  regionName: String
  councilName: String
  wardName: String
  locationDescription: String
  reportedAt: String
  description: String
  latitude: Float
  longitude: Float
  allocationsCount: Int!
  tasksCount: Int!
  responseActive: Boolean!
}

type MobileIncidentTask {
  id: ID
  title: String
  priority: String
  status: String
  progressPercent: Int
  dueDate: String
  assignedToName: String
}

type MobileIncidentAllocation {
  id: ID
  resourceName: String
  quantityRequested: String
  quantityAllocated: String
  unit: String
  status: String
}

"""Foreground mobile invalidation only; durable recovery always uses the committed cursor."""
type Subscription {
  mobileSync(afterSequence: ID!): SyncWakeup!
}

type SyncWakeup {
  """Latest committed global cursor. It is an opaque 64-bit decimal string to clients."""
  sequence: ID!
  occurredAt: String!
}

type MobileHome {
  generatedAt: String!
  """Cursor captured before the snapshot reads, safe for subsequent delta recovery."""
  syncCursor: ID!
  """Hash of actor, permissions and jurisdiction; a change requires a fresh snapshot."""
  syncScopeKey: String!
  viewer: MobileViewer!
  incidents: MobileIncidentPage!
  notifications: MobileNotificationPage!
}

type MobileViewer {
  id: ID!
  name: String!
  email: String
  roles: [String!]!
  permissions: [String!]!
}

type MobileIncidentPage {
  items: [MobileIncident!]!
  currentPage: Int!
  lastPage: Int!
  total: Int!
}

type MobileIncident {
  id: ID!
  title: String!
  status: String
  workflowStatus: String
  workflowStatusLabel: String
  severity: String
  hazardName: String
  districtName: String
  regionName: String
  locationDescription: String
  reportedAt: String
  allocationsCount: Int!
  tasksCount: Int!
  responseActive: Boolean!
}

type MobileNotificationPage {
  items: [MobileNotification!]!
  unreadCount: Int!
  latestId: ID
  hasMore: Boolean!
  nextBeforeId: ID
}

type MobileNotification {
  id: ID!
  type: String
  title: String!
  message: String
  link: String
  entityType: String
  entityId: ID
  severity: String
  read: Boolean!
  createdAt: String
  category: String
  categoryLabel: String
  categoryIcon: String
}
