# Copy to ".env" (git-ignored). NEVER commit real secrets.
# Full production list: docs/env.prod.example
# Deploy guide: docs/go-live/DOCKER-DEPLOY.md
#
# HONESTY: filling this file and starting compose is not a go-live certificate.

# ── Required for any non-local / Docker prod profile ────────────────────────
# Generate: openssl rand -base64 48
DMIS_AUTH_JWT_SECRET=replace-with-a-real-random-secret-at-least-32-bytes-long

# Staging only may keep a local password. Production overlay FORBIDS defaults.
DB_PASSWORD=dmis_pass
DB_NAME=dmis
DB_USERNAME=dmis_app

# Public SPA origin(s), comma-separated. Required on production edge.
# Example: https://emaafa.pmo.go.tz
DMIS_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:8081

# ── TLS edge (docker-compose.prod.yml) ──────────────────────────────────────
# Public hostname with DNS A/AAAA to this host (Let's Encrypt).
# DMIS_PUBLIC_HOST=emaafa.pmo.go.tz
# CADDY_EMAIL=ops@pmo.go.tz

# ── Immutable image tags (production pull — preferred over build on server) ─
# DMIS_IMAGE_BACKEND=registry.example.gov/emaafa/dmis-backend:2026.07.14
# DMIS_IMAGE_FRONTEND=registry.example.gov/emaafa/dmis-frontend:2026.07.14
# DMIS_IMAGE_EW_PDF=registry.example.gov/emaafa/ew-pdf:2026.07.14

# ── Optional publish ports (staging compose only; prod overlay closes most) ─
# DMIS_FRONTEND_PUBLISH_PORT=8081
# DMIS_BACKEND_PUBLISH_PORT=8080
# DMIS_DB_PUBLISH_PORT=5440

# ── Persistent file storage (Docker named volume dmis_storage) ─────────────
# Bulletin PDFs, publications, uploads. Default is correct inside the backend container.
# DMIS_STORAGE_PUBLIC_ROOT=/app/storage/public

# ── SMS (M-Gov) — blank = pending logs; or set residual accept after sign-off ─
MGOV_API_KEY=
MGOV_SYSTEM_ID=
MGOV_SMS_URL=
MGOV_MOBILE_SERVICE_ID=
MGOV_SENDER_ID=
DMIS_MGOV_DLR_SECRET=
DMIS_GO_LIVE_ACCEPT_SMS_DEFERRED=false

# ── Email — blank = pending logs; or residual accept after sign-off ─────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=e-MAAFA
DMIS_GO_LIVE_ACCEPT_EMAIL_DEFERRED=false

# ── Other residual accepts (written sign-off only) ──────────────────────────
DMIS_GO_LIVE_ACCEPT_SPARSE_PHONES=false
DMIS_GO_LIVE_ACCEPT_PDF_SIDECAR=false
DMIS_GO_LIVE_ACCEPT_STORAGE_PARTIAL=false
DMIS_SCENARIO_INJECTS_ENABLED=false
DMIS_ALLOW_DEMO_ACCOUNTS_IN_PROD=false
